
<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@ page import="cafe.project.servlet.models.Suppliers"%>
<%@ page import="cafe.project.servlet.repositories.SupplierDAO"%>

<%!public String esc(String value) {
		if (value == null) {
			return "";
		}

		return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
				.replace("'", "&#39;");
	}%>

<%
String ctx = request.getContextPath();

// Get supplier from the servlet
Suppliers s = (Suppliers) request.getAttribute("supplier");

// Get validation values from the servlet
String nameValue = (String) request.getAttribute("nameValue");
String contactValue = (String) request.getAttribute("contactValue");

String error = (String) request.getAttribute("error");
String nameError = (String) request.getAttribute("nameError");
String contactError = (String) request.getAttribute("contactError");

// Find supplier by ID if it was not provided by the servlet
if (s == null) {
	String editId = request.getParameter("id");

	if (editId == null || editId.trim().isEmpty()) {
		editId = request.getParameter("supplier_id");
	}

	if (editId != null && !editId.trim().isEmpty()) {
		try {
	SupplierDAO supplierDAO = new SupplierDAO();
	s = supplierDAO.getSupplierById(editId.trim());
		} catch (Exception e) {
	application.log("Unable to load supplier for editing.", e);
		}
	}
}

// Redirect if the supplier cannot be found
if (s == null) {
	response.sendRedirect(ctx + "/suppliers?action=list");
	return;
}

// Preserve entered values after validation errors
String displayName = nameValue != null ? nameValue : s.getName();

String displayContact = contactValue != null ? contactValue : s.getContact_info();
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Edit Supplier - Cafe Management System</title>

<!-- Google Fonts & Bootstrap Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
	rel="stylesheet">

<link
	href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
	rel="stylesheet">

<!-- Centralized Cafe Theme -->
<link rel="stylesheet" href="<%=ctx%>/assets/css/cafe-theme.css">
</head>

<body>

	<main class="page-wrapper">
		<div class="container">

			<!-- Breadcrumb Navigation -->
			<div class="cafe-breadcrumb"
				style="max-width: 740px; margin: 0 auto 16px auto;">

				<a href="<%=ctx%>/home.jsp"> <i class="bi bi-house-door me-1"></i>
					Dashboard
				</a> <span class="separator"> <i class="bi bi-chevron-right"></i>
				</span> <a href="<%=ctx%>/suppliers"> Suppliers </a> <span
					class="separator"> <i class="bi bi-chevron-right"></i>
				</span> <span>Edit Supplier</span>
			</div>

			<div class="form-container">

				<!-- Page Header -->
				<div class="mb-4 pb-3 border-bottom">
					<h1 class="page-title mb-1">
						<i class="bi bi-pencil-square"></i> Edit Supplier Profile
					</h1>

					<p class="page-subtitle">Update vendor trade name or delivery
						contact credentials.</p>
				</div>

				<!-- General Error Message -->
				<%
				if (error != null && !error.trim().isEmpty()) {
				%>

				<div class="alert alert-danger alert-dismissible fade show"
					role="alert">

					<div class="d-flex align-items-center gap-2">
						<i class="bi bi-exclamation-triangle-fill text-danger"></i> <span><%=esc(error)%></span>
					</div>

					<button type="button" class="btn-close" data-bs-dismiss="alert"
						aria-label="Close"></button>
				</div>

				<%
				}
				%>

				<!-- Edit Supplier Form -->
				<form method="post" action="<%=ctx%>/suppliers"
					accept-charset="UTF-8" novalidate>

					<input type="hidden" name="action" value="update"> <input
						type="hidden" name="supplier_id"
						value="<%=esc(s.getSupplier_id())%>">

					<!-- Supplier Name -->
					<div class="mb-3">

						<label for="name" class="form-label"> Supplier Name <span
							class="required" aria-hidden="true">*</span>
						</label> <input id="name" type="text" name="name"
							class="form-control <%=nameError != null ? "is-invalid" : ""%>"
							maxlength="100" value="<%=esc(displayName)%>"
							placeholder="Enter supplier name" required>

						<%
						if (nameError != null && !nameError.trim().isEmpty()) {
						%>

						<div class="field-error">
							<i class="bi bi-exclamation-circle-fill"></i> <span><%=esc(nameError)%></span>
						</div>

						<%
						}
						%>

						<div class="form-text">Active supplier names must remain
							unique across the cafe catalog.</div>
					</div>

					<!-- Contact Information -->
					<div class="mb-4">

						<label for="contact_info" class="form-label"> Contact
							Information <span class="required" aria-hidden="true">*</span>
						</label> <input id="contact_info" type="text" name="contact_info"
							class="form-control <%=contactError != null ? "is-invalid" : ""%>"
							maxlength="150" value="<%=esc(displayContact)%>"
							placeholder="Enter contact information" required>

						<%
						if (contactError != null && !contactError.trim().isEmpty()) {
						%>

						<div class="field-error">
							<i class="bi bi-exclamation-circle-fill"></i> <span><%=esc(contactError)%></span>
						</div>

						<%
						}
						%>

						<div class="form-text">Phone number, representative direct
							email, or delivery warehouse address.</div>
					</div>

					<!-- Form Action Buttons -->
					<div
						class="d-flex justify-content-between align-items-center gap-2 pt-3 border-top">

						<a href="<%=ctx%>/suppliers?action=list"
							class="btn btn-outline-secondary"> <i class="bi bi-x-lg"></i>
							Cancel
						</a>

						<button type="submit" class="btn btn-primary">
							<i class="bi bi-check2"></i> Update Supplier
						</button>

					</div>
				</form>

			</div>
		</div>
	</main>

	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
