	public int softDelete(String batch_id) {
		int rowsAffected = 0;
		if (!"deleted".equals(batch_id)) {
			recordDelete(batch_id);
			setWasteLogs(batch_id);
			String sql = "UPDATE ingredient_batches SET isdeleted = 1 WHERE batch_id = ?";
			
			try {
				PreparedStatement ps = con.prepareStatement(sql);
				
				ps.setString(1, batch_id);
				
				rowsAffected += ps.executeUpdate();
				System.out.println(rowsAffected + " row(s) effected in deleting Ingredient Batch.");
			}catch(SQLException e) {
				System.out.println("Deleting Ingredient Batch Failed - " + e);
			}
			
		}
		return rowsAffected;
	}

	public int recover(String batch_id) {
		int rowsAffected = 0;
		for (DeleteRecord dr : deleteRecordRepo.getByParentId(batch_id)) {
			
			try {
				PreparedStatement ps = con.prepareStatement("UPDATE waste_logs SET batch_id = ? WHERE batch_id = 'deleted' AND waste_id = ?");
				
				ps.setString(1, dr.getParent_id());
				ps.setString(2, dr.getChild_id());
				
				rowsAffected += ps.executeUpdate();
				System.out.println(rowsAffected + " row(s) effected in setting Waste Logs.");
			}catch(SQLException e) {
				System.out.println("Setting Waste Logs Failed - " + e);
			}
		}
		
		deleteRecordRepo.deleteByParentId(batch_id);
		
		String sql = "UPDATE ingredient_batches SET isdeleted = 0 WHERE batch_id = ?";
		try {
			PreparedStatement ps = con.prepareStatement(sql);
			
			ps.setString(1, batch_id);
			
			rowsAffected += ps.executeUpdate();
			System.out.println(rowsAffected + " row(s) effected in recovering Ingredient Batch.");
		}catch(SQLException e) {
			System.out.println("Recovering Ingredient Batch Failed - " + e);
		}
		
		return rowsAffected;
	}

