	}
	
	private int setWasteLogs(String batch_id) {
		int rowsAffected = 0;
		
		try {
			PreparedStatement ps = con.prepareStatement("UPDATE waste_logs SET batch_id = 'deleted' WHERE batch_id = ?");
			
			ps.setString(1, batch_id);
			
			rowsAffected += ps.executeUpdate();
			System.out.println(rowsAffected + " row(s) effected in setting Waste Logs.");
