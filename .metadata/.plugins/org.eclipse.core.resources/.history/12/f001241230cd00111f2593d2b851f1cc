	public int add(IngredientBatch entity) {
		String sql = """
				    INSERT INTO ingredient_batches
				    (batch_id, remaining_quantity, manufactured_date, expire_date, branch_id,
				     isdeleted, created_at, ingredient_type_id, unit_cost, quantity_ordered, total_import_cost, import_id)
				    VALUES (?, ?, ?, ?, ?, 0, NOW(), ?, ?, ?, ?, ?)
				""";
		int r = 0;
		try {
			PreparedStatement ps = con.prepareStatement(sql);
			
			ps.setString(1, entity.getBatch_id());
			ps.setBigDecimal(2, entity.getRemaining_quantity());
			ps.setString(3, entity.getManufactured_date().toString());
			ps.setString(4, entity.getExpire_date().toString());
			ps.setString(5, entity.getBranch_id());
			ps.setString(6, entity.getIngredient_type_id());
			ps.setBigDecimal(7, entity.getUnit_cost());
			ps.setBigDecimal(8, entity.getQuantity_ordered());
			ps.setBigDecimal(9, entity.getTotal_import_cost());
			ps.setString(10, entity.getImport_id());
			
			r = ps.executeUpdate();
			System.out.println(r + " row(s) effected in adding Product.");
		}catch(SQLException e) {
			System.out.println("Adding Ingredient Batch Failed - " + e);
		}
		
		return r;
	}

	public List<IngredientBatch> findAllAdmin() {
		String sql = """
				    SELECT ib.*, b.name AS branch_name, it.name AS ingredient_type_name
				    FROM ingredient_batches ib
				    LEFT JOIN branches b ON ib.branch_id = b.branch_id
				    LEFT JOIN ingredient_types it ON ib.ingredient_type_id = it.ingredient_type_id
				    WHERE ib.isdeleted = 0
				    ORDER BY ib.created_at DESC
				""";
		List<IngredientBatch> ingredientBatches = new ArrayList<>();
		try {
			PreparedStatement ps = con.prepareStatement(sql);
			ResultSet rs = ps.executeQuery();
			
			while(rs.next()) {
				ingredientBatches.add(ingredientBatchMapper.mapRow(rs));
			}
			
		}catch(SQLException e) {
			System.out.println("Get All Ingredient Batches Failed - " + e);
		}
		return ingredientBatches;
	}
	
