<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.util.List"%>
<%@ page import="java.time.format.DateTimeFormatter"%>
<%@ page import="java.net.URLEncoder"%>
<%@ page import="model.StockImports"%>

<%!public String esc(String value) {
		if (value == null) {
			return "";
		}
		return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
				.replace("'", "&#39;");
	}%>

<%
List<StockImports> stockImports = (List<StockImports>) request.getAttribute("stockImports");

String ctx = request.getContextPath();
String message = request.getParameter("message");

String alertMessage = "";
String alertType = "success";

if ("added".equals(message)) {
	alertMessage = "Stock import record added successfully.";
} else if ("updated".equals(message)) {
	alertMessage = "Stock import record updated successfully.";
} else if ("deleted".equals(message)) {
	alertMessage = "Stock import record moved to deleted list.";
} else if ("restored".equals(message)) {
	alertMessage = "Stock import record restored successfully.";
}

DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd-MM-yyyy HH:mm:ss");
%>

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Stock Imports - Cafe Management System</title>

	<!-- Google Fonts & Bootstrap Icons -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

	<!-- Centralized Cafe Theme -->
	<link rel="stylesheet" href="<%=ctx%>/assets/css/cafe-theme.css">
</head>

<body>

	<!-- Top Navigation Bar -->
	<jsp:include page="/includes/navbar.jsp">
		<jsp:param name="activeNav" value="stockImports" />
	</jsp:include>

	<main class="page-wrapper">
		<div class="main-container">

			<!-- Breadcrumb Navigation -->
			<div class="cafe-breadcrumb">
				<a href="<%=ctx%>/home.jsp"><i class="bi bi-house-door me-1"></i>Dashboard</a>
				<span class="separator"><i class="bi bi-chevron-right"></i></span>
				<span>Stock Imports</span>
			</div>

			<!-- Page Header Box -->
			<div class="page-header-box">
				<div>
					<h1 class="page-title">
						<i class="bi bi-box-seam-fill"></i>Stock Imports Logistics
					</h1>
					<p class="page-subtitle">Track cafe shipments, branch receipts, delivery timestamps, and procurement costs.</p>
				</div>

				<div class="d-flex gap-2 flex-wrap">
					<a href="<%=ctx%>/stockimport?action=deleted" class="btn btn-outline-secondary">
						<i class="bi bi-trash3"></i>Deleted List
					</a>
					<a href="<%=ctx%>/stockimport?action=add" class="btn btn-primary">
						<i class="bi bi-plus-lg"></i>Add Stock Import
					</a>
				</div>
			</div>

			<!-- Flash Alert Message -->
			<% if (!alertMessage.isEmpty()) { %>
			<div class="alert alert-<%=alertType%> alert-dismissible fade show" role="alert">
				<div class="d-flex align-items-center gap-2">
					<i class="bi <%= "success".equals(alertType) ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger" %>"></i>
					<span><%=alertMessage%></span>
				</div>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
			<% } %>

			<!-- Search & Count Toolbar -->
			<div class="search-toolbar">
				<div class="search-input-wrap">
					<i class="bi bi-search search-icon"></i>
					<input type="text" id="searchInput" class="form-control"
						placeholder="Search by supplier, branch, or date..."
						autocomplete="off" aria-label="Search stock imports">
				</div>

				<div class="record-count-badge">
					<span>Total Active Deliveries:</span>
					<strong id="totalCount"><%=stockImports == null ? 0 : stockImports.size()%></strong>
				</div>
			</div>

			<!-- Stock Import Table -->
			<div class="table-responsive">
				<table class="table cafe-table align-middle" id="stockImportTable">
					<thead>
						<tr>
							<th style="width: 70px;">No.</th>
							<th style="width: 210px;">Import Timestamp</th>
							<th>Branch Destination</th>
							<th>Supplier Vendor</th>
							<th style="width: 170px; text-align: right;">Total Cost</th>
							<th style="min-width: 160px; width: 170px;">Actions</th>
						</tr>
					</thead>

					<tbody>
						<%
						if (stockImports != null && !stockImports.isEmpty()) {
							int no = 1;
							for (StockImports item : stockImports) {
								String supplierDisplay = item.getSupplierName() != null ? item.getSupplierName() : "Unknown (" + item.getSupplierId() + ")";
								String branchDisplay = item.getBranchName() != null ? item.getBranchName() : "Unknown (" + item.getBranchId() + ")";
						%>
						<tr class="import-row">
							<td class="tabular-num"><%=no++%></td>
							<td class="tabular-num">
								<i class="bi bi-clock-history me-1 text-muted"></i>
								<%=item.getImportedAt() == null ? "-" : item.getImportedAt().format(formatter)%>
							</td>
							<td>
								<div class="d-flex align-items-center gap-2">
									<i class="bi bi-shop text-muted"></i>
									<span><%=esc(branchDisplay)%></span>
								</div>
							</td>
							<td>
								<div class="d-flex align-items-center gap-2">
									<i class="bi bi-truck text-muted"></i>
									<strong><%=esc(supplierDisplay)%></strong>
								</div>
							</td>
							<td style="text-align: right;">
								<span class="cost-display">
									$ <%=item.getTotalCost() == null ? "0.00" : String.format("%,.2f", item.getTotalCost())%>
								</span>
							</td>
							<td>
								<div class="action-buttons">
									<!-- Edit -->
									<a href="<%=ctx%>/stockimport?action=edit&amp;id=<%=URLEncoder.encode(item.getImportId(), "UTF-8")%>"
										class="btn btn-sm btn-warning" title="Edit delivery record">
										<i class="bi bi-pencil-square"></i>Edit
									</a>

									<!-- Delete -->
									<form method="post" action="<%=ctx%>/stockimport"
										onsubmit="return confirm('Are you sure you want to move this delivery to the deleted list?');">
										<input type="hidden" name="action" value="delete">
										<input type="hidden" name="import_id" value="<%=esc(item.getImportId())%>">
										<button class="btn btn-sm btn-danger" type="submit" title="Delete delivery record">
											<i class="bi bi-trash3"></i>Delete
										</button>
									</form>
								</div>
							</td>
						</tr>
						<%
							}
						} else {
						%>
						<tr id="initialEmptyRow">
							<td colspan="6" class="empty-state-box">
								<div class="empty-state-icon">
									<i class="bi bi-box-seam-fill"></i>
								</div>
								<h3 class="empty-state-title">No Stock Imports Recorded</h3>
								<p class="empty-state-text">Track incoming coffee batches and dairy deliveries by recording your first stock import.</p>
								<a href="<%=ctx%>/stockimport?action=add" class="btn btn-primary">
									<i class="bi bi-plus-lg"></i>Add Stock Import
								</a>
							</td>
						</tr>
						<%
						}
						%>
					</tbody>
				</table>
			</div>

		</div>
	</main>

	<!-- Footer -->
	<jsp:include page="/includes/footer.jsp" />

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<script>
		const searchInput = document.getElementById("searchInput");
		const table = document.getElementById("stockImportTable");
		const totalCount = document.getElementById("totalCount");
		const tbody = table.querySelector("tbody");

		searchInput.addEventListener("input", function() {
			const keyword = this.value.toLowerCase().trim();
			const rows = tbody.querySelectorAll(".import-row");
			let count = 0;

			rows.forEach(function(row) {
				const text = row.textContent.toLowerCase();
				const matched = text.includes(keyword);
				row.style.display = matched ? "" : "none";
				if (matched) count++;
			});

			totalCount.textContent = count;

			const oldMessage = document.getElementById("noResultRow");
			if (oldMessage) {
				oldMessage.remove();
			}

			if (keyword !== "" && count === 0) {
				const noResultRow = document.createElement("tr");
				noResultRow.id = "noResultRow";

				const cell = document.createElement("td");
				cell.colSpan = 6;
				cell.className = "empty-state-box";
				cell.innerHTML = `
					<div class="empty-state-icon">
						<i class="bi bi-search"></i>
					</div>
					<h3 class="empty-state-title">No Matching Stock Imports</h3>
					<p class="empty-state-text">No delivery records match "<strong>` + keyword.replace(/</g, "&lt;").replace(/>/g, "&gt;") + `</strong>". Try searching by branch name or supplier.</p>
				`;

				noResultRow.appendChild(cell);
				tbody.appendChild(noResultRow);
			}
		});
	</script>

</body>
</html>
