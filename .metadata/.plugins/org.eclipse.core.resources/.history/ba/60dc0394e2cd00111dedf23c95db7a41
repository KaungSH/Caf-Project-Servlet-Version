<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@ page import="java.util.List"%>
<%@ page import="cafe.project.servlet.models.Suppliers"%>
<%@ page import="java.time.format.DateTimeFormatter"%>
<%@ page import="cafe.project.servlet.repositories.SupplierDAO" %>
<%!public String esc(String value) {
		if (value == null) {
			return "";
		}
		return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
				.replace("'", "&#39;");
	}%>

<%
List<Suppliers> suppliers = (List<Suppliers>) request.getAttribute("suppliers");
if (suppliers == null) {
	try {
		SupplierDAO supplierDAO = new SupplierDAO();
		suppliers = supplierDAO.getDeletedSuppliers();
	} catch (Exception e) {
		suppliers = new java.util.ArrayList<>();
	}
}

String ctx = request.getContextPath();
String message = request.getParameter("message");

DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd-MM-yyyy HH:mm:ss");

String alertMessage = "";
String alertType = "success";

if ("restored".equals(message)) {
	alertMessage = "Supplier restored successfully.";
} else if ("permanentDeleted".equals(message)) {
	alertMessage = "Supplier permanently deleted.";
}
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deleted Suppliers - Cafe Management System</title>

<!-- Google Fonts & Bootstrap Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
	rel="stylesheet">
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
	rel="stylesheet">

<!-- Centralized Cafe Theme -->
<link rel="stylesheet" href="<%=ctx%>/assets/css/cafe-theme.css">
</head>

<body>

	<main class="page-wrapper">
		<div class="main-container">

			<!-- Breadcrumb Navigation -->
			<div class="cafe-breadcrumb">
				<a href="<%=ctx%>/home.jsp"><i class="bi bi-house-door me-1"></i>Dashboard</a>
				<span class="separator"><i class="bi bi-chevron-right"></i></span> <a
					href="<%=ctx%>/suppliers">Suppliers</a> <span class="separator"><i
					class="bi bi-chevron-right"></i></span> <span>Deleted Suppliers</span>
			</div>

			<!-- Page Header Box -->
			<div class="page-header-box">
				<div>
					<h1 class="page-title">
						<i class="bi bi-trash3-fill"></i>Deleted Suppliers Archive
					</h1>
					<p class="page-subtitle">Restore soft-deleted supplier records
						back to active service, or permanently remove them.</p>
				</div>

				<div class="d-flex gap-2 flex-wrap">
					<a href="<%=ctx%>/suppliers?action=list" class="btn btn-primary">
						<i class="bi bi-arrow-left"></i>Back to Active Suppliers
					</a>
				</div>
			</div>

			<!-- Flash Alert Message -->
			<%
			if (!alertMessage.isEmpty()) {
			%>
			<div class="alert alert-<%=alertType%> alert-dismissible fade show"
				role="alert">
				<div class="d-flex align-items-center gap-2">
					<i
						class="bi <%="success".equals(alertType) ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger"%>"></i>
					<span><%=alertMessage%></span>
				</div>
				<button type="button" class="btn-close" data-bs-dismiss="alert"
					aria-label="Close"></button>
			</div>
			<%
			}
			%>

			<!-- Search & Count Toolbar -->
			<div class="search-toolbar">
				<div class="search-input-wrap">
					<i class="bi bi-search search-icon"></i> <input type="text"
						id="searchInput" class="form-control"
						placeholder="Search by supplier name or contact info..."
						autocomplete="off" aria-label="Search deleted suppliers">
				</div>

				<div class="record-count-badge">
					<span>Archived Records:</span> <strong id="totalCount"><%=suppliers == null ? 0 : suppliers.size()%></strong>
				</div>
			</div>

			<!-- Deleted Suppliers Table -->
			<div class="table-responsive">
				<table class="table cafe-table align-middle"
					id="deletedSupplierTable">
					<thead>
						<tr>
							<th style="width: 70px;">No.</th>
							<th>Supplier Name</th>
							<th>Contact Information</th>
							<th style="width: 210px;">Created At</th>
							<th style="min-width: 220px; width: 240px;">Actions</th>
						</tr>
					</thead>

					<tbody>
						<%
						if (suppliers != null && !suppliers.isEmpty()) {
							int no = 1;
							for (Suppliers sup : suppliers) {
						%>
						<tr class="supplier-row">
							<td class="tabular-num"><%=no++%></td>
							<td>
								<div class="d-flex align-items-center gap-2">
									<span class="status-badge-deleted">Archived</span> <strong><%=esc(sup.getName())%></strong>
								</div>
							</td>
							<td><span class="text-muted"><%=esc(sup.getContact_info())%></span>
							</td>
							<td class="tabular-num"><i
								class="bi bi-calendar3 me-1 text-muted"></i> <%=sup.getCreated_at() == null ? "-" : sup.getCreated_at().format(formatter)%>
							</td>
							<td>
								<div class="action-buttons">
									<!-- Restore -->
									<form method="post" action="<%=ctx%>/suppliers"
										onsubmit="return confirm('Restore this supplier back to the active directory?');">
										<input type="hidden" name="action" value="restore"> <input
											type="hidden" name="supplier_id"
											value="<%=esc(sup.getSupplier_id())%>">
										<button class="btn btn-sm btn-success" type="submit"
											title="Restore supplier">
											<i class="bi bi-arrow-counterclockwise"></i>Restore
										</button>
									</form>

									<!-- Permanent Delete -->
									<form method="post" action="<%=ctx%>/suppliers"
										onsubmit="return confirm('Permanently delete this supplier? This action cannot be undone.');">
										<input type="hidden" name="action" value="permanentDelete">
										<input type="hidden" name="supplier_id"
											value="<%=esc(sup.getSupplier_id())%>">
										<button class="btn btn-sm btn-danger" type="submit"
											title="Permanently delete">
											<i class="bi bi-x-octagon"></i>Permanent Delete
										</button>
									</form>
								</div>
							</td>
						</tr>
						<%
						}
						} else {
						%>
						<tr id="emptyRow">
							<td colspan="5" class="empty-state-box">
								<div class="empty-state-icon">
									<i class="bi bi-check2-circle"></i>
								</div>
								<h3 class="empty-state-title">Recycle Bin is Empty</h3>
								<p class="empty-state-text">There are currently no archived
									or deleted suppliers in the system.</p> <a
								href="<%=ctx%>/suppliers?action=list" class="btn btn-primary">
									<i class="bi bi-arrow-left"></i>Return to Active Suppliers
							</a>
							</td>
						</tr>
						<%
						}
						%>
					</tbody>
				</table>
			</div>

		</div>
	</main>
	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<script>
		const searchInput = document.getElementById("searchInput");
		const table = document.getElementById("deletedSupplierTable");
		const totalCount = document.getElementById("totalCount");
		const tbody = table.querySelector("tbody");

		searchInput.addEventListener("input", function () {
			const keyword = this.value.toLowerCase().trim();
			const rows = tbody.querySelectorAll(".supplier-row");
			let count = 0;

			rows.forEach(function (row) {
				const text = row.textContent.toLowerCase();
				const matched = text.includes(keyword);
				row.style.display = matched ? "" : "none";
				if (matched) count++;
			});

			totalCount.textContent = count;

			const oldMessage = document.getElementById("noResultRow");
			if (oldMessage) {
				oldMessage.remove();
			}

			if (keyword !== "" && count === 0) {
				const noResultRow = document.createElement("tr");
				noResultRow.id = "noResultRow";

				const cell = document.createElement("td");
				cell.colSpan = 5;
				cell.className = "empty-state-box";
				cell.innerHTML = `
					<div class="empty-state-icon">
						<i class="bi bi-search"></i>
					</div>
					<h3 class="empty-state-title">No Matching Deleted Suppliers</h3>
					<p class="empty-state-text">No deleted records match "<strong>` + keyword.replace(/</g, "&lt;").replace(/>/g, "&gt;") + `</strong>".</p>
				`;

				noResultRow.appendChild(cell);
				tbody.appendChild(noResultRow);
			}
		});
	</script>

</body>
</html>