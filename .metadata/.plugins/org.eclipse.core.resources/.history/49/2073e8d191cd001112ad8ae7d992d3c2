	public List<ProductTypeListModel> findAll(String branch_id, HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		List<ProductTypeListModel> list = new ArrayList<>();

		for (ProductType item : pt.findAll(branch_id)) {
			String categoryName = cr.findById(item.getCategory_id()).getName();
			String employeeName = er.findByIdAdmin(item.getEmployee_id()).getName();

			list.add(toListModel2(item, categoryName, employeeName, bs.findById(item.getBranch_id(), request, response).getName()));
		}

		return list;
	}
	
