package cafe.project.servlet.repositories;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.List;

import cafe.project.servlet.repositories.entities.ProductType;
import cafe.project.servlet.repositories.mappers.LoginMapper;
import cafe.project.servlet.repositories.mappers.LoginMapper2;
import cafe.project.servlet.servlets.MyConnection;
import cafe.project.servlet.models.LoginDto;

public class LoginRepository {
	
	Connection con = MyConnection.getConnection();
	private LoginMapper loginMapper = new LoginMapper();
	private LoginMapper2 loginMapper2 = new LoginMapper2();
	
	public LoginDto findById(String id) {
		String sql = "SELECT * FROM employees WHERE employee_id = ?";
		LoginDto loginDto = null;
		try {
			PreparedStatement ps = con.prepareStatement(sql);
			ps.setString(1, id);
			ResultSet rs = ps.executeQuery();
			
			if (rs.next()) {
	            loginDto = loginMapper.mapRow(rs);
	        }
			
		}catch(SQLException e) {
			System.out.println("Find LoginDto by Id Failed - " + e);
		}
		
		return loginDto;
	}
	
	public LoginDto findByEmail(String email) {
		String sql = "SELECT * FROM employees WHERE email = ?";
		LoginDto loginDto = null;
		try {
			PreparedStatement ps = con.prepareStatement(sql);
			ps.setString(1, email);
			ResultSet rs = ps.executeQuery();
			
			if (rs.next()) {
	            loginDto = loginMapper.mapRow(rs);
	        }
			
		}catch(SQLException e) {
			System.out.println("Find LoginDto by Email Failed - " + e);
		}
		
		return loginDto;
	}
	
	public LoginDto findByLogin(String email, String password) {
		String sql = "SELECT e.*, r.name role_name, r.role_id role_id, b.name branch_name, b.branch_id branch_id, s.name status_name, s.employee_status_id employee_status_id FROM employees e LEFT JOIN employee_roles r ON e.employee_role_id = r.role_id LEFT JOIN employee_statuses s ON e.employee_status_id = s.employee_status_id LEFT JOIN branches b ON e.branch_id = b.branch_id WHERE e.email = ? AND e.password = ?";
		List<LoginDto> entities = jdbcTemplate.query(sql, new LoginMapper2(), email, password);
		return entities.isEmpty()?null:entities.get(0);
	}

}
