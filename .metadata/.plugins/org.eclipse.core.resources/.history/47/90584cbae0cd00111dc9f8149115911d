<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.util.List"%>
<%@ page import="java.time.format.DateTimeFormatter"%>
<%@ page import="cafe.project.servlet.models.StockImports"%>
<%@ page import="cafe.project.servlet.repositories.StockImportDAO.SupplierOption"%>
<%@ page import="repository.StockImportDAO.BranchOption"%>
<%@ page import="repository.StockImportDAO.EmployeeOption"%>

<%!public String esc(String value) {
		if (value == null) {
			return "";
		}
		return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
				.replace("'", "&#39;");
	}%>

<%
StockImports stockImport = (StockImports) request.getAttribute("stockImport");
String ctx = request.getContextPath();

if (stockImport == null) {
	response.sendRedirect(ctx + "/stockimport");
	return;
}

List<SupplierOption> suppliers = (List<SupplierOption>) request.getAttribute("suppliers");
List<BranchOption> branches = (List<BranchOption>) request.getAttribute("branches");
List<EmployeeOption> employees = (List<EmployeeOption>) request.getAttribute("employees");

String error = (String) request.getAttribute("error");
String supplierError = (String) request.getAttribute("supplierError");
String branchError = (String) request.getAttribute("branchError");
String employeeError = (String) request.getAttribute("employeeError");
String importedAtError = (String) request.getAttribute("importedAtError");
String totalCostError = (String) request.getAttribute("totalCostError");

String supplierIdValue = (String) request.getAttribute("supplierIdValue");
String branchIdValue = (String) request.getAttribute("branchIdValue");
String employeeIdValue = (String) request.getAttribute("employeeIdValue");
String importedAtValue = (String) request.getAttribute("importedAtValue");
String totalCostValue = (String) request.getAttribute("totalCostValue");

DateTimeFormatter inputFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm");

String displaySupplierId = supplierIdValue != null ? supplierIdValue : stockImport.getSupplierId();
String displayBranchId = branchIdValue != null ? branchIdValue : stockImport.getBranchId();
String displayEmployeeId = employeeIdValue != null ? employeeIdValue : stockImport.getEmployeeId();

String displayImportedAt = importedAtValue != null ? importedAtValue : 
	(stockImport.getImportedAt() != null ? stockImport.getImportedAt().format(inputFormatter) : "");

String displayTotalCost = totalCostValue != null ? totalCostValue : 
	(stockImport.getTotalCost() != null ? stockImport.getTotalCost().toPlainString() : "");
%>

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Edit Stock Import - Cafe Management System</title>

	<!-- Google Fonts & Bootstrap Icons -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

	<!-- Centralized Cafe Theme -->
	<link rel="stylesheet" href="<%=ctx%>/assets/css/cafe-theme.css">
</head>

<body>

	<!-- Top Navigation Bar -->
	<jsp:include page="/includes/navbar.jsp">
		<jsp:param name="activeNav" value="stockImports" />
	</jsp:include>

	<main class="page-wrapper">
		<div class="container">

			<!-- Breadcrumb Navigation -->
			<div class="cafe-breadcrumb" style="max-width: 740px; margin: 0 auto 16px auto;">
				<a href="<%=ctx%>/home.jsp"><i class="bi bi-house-door me-1"></i>Dashboard</a>
				<span class="separator"><i class="bi bi-chevron-right"></i></span>
				<a href="<%=ctx%>/stockimport">Stock Imports</a>
				<span class="separator"><i class="bi bi-chevron-right"></i></span>
				<span>Edit Delivery Record</span>
			</div>

			<div class="form-container">

				<div class="mb-4 pb-3 border-bottom">
					<h1 class="page-title mb-1">
						<i class="bi bi-pencil-square"></i>Edit Stock Import Delivery
					</h1>
					<p class="page-subtitle">Update vendor, destination branch, delivery time, or cost amount.</p>
				</div>

				<% if (error != null) { %>
				<div class="alert alert-danger alert-dismissible fade show" role="alert">
					<div class="d-flex align-items-center gap-2">
						<i class="bi bi-exclamation-triangle-fill text-danger"></i>
						<span><%=esc(error)%></span>
					</div>
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
				<% } %>

				<form method="post" action="<%=ctx%>/stockimport" accept-charset="UTF-8" novalidate>
					<input type="hidden" name="action" value="update">
					<input type="hidden" name="import_id" value="<%=esc(stockImport.getImportId())%>">

					<!-- Supplier Selection -->
					<div class="mb-3">
						<label for="supplier_id" class="form-label">
							Supplier Vendor <span class="required" aria-hidden="true">*</span>
						</label>
						<select id="supplier_id" name="supplier_id"
							class="form-select <%=supplierError != null ? "is-invalid" : ""%>" required>
							<option value="">-- Choose Supplier Partner --</option>
							<%
							boolean supplierFound = false;
							if (suppliers != null) {
								for (SupplierOption sup : suppliers) {
									boolean selected = sup.getSupplierId().equals(displaySupplierId);
									if (selected) supplierFound = true;
							%>
							<option value="<%=esc(sup.getSupplierId())%>" <%=selected ? "selected" : ""%>>
								<%=esc(sup.getName())%>
							</option>
							<%
								}
							}
							if (!supplierFound && stockImport.getSupplierId() != null) {
								String currentSupName = stockImport.getSupplierName() != null ? stockImport.getSupplierName() : stockImport.getSupplierId();
							%>
							<option value="<%=esc(stockImport.getSupplierId())%>" selected>
								<%=esc(currentSupName)%> (Current / Inactive)
							</option>
							<%
							}
							%>
						</select>

						<% if (supplierError != null) { %>
						<div class="field-error">
							<i class="bi bi-exclamation-circle-fill"></i>
							<span><%=esc(supplierError)%></span>
						</div>
						<% } %>
						<div class="form-text">Active supplier partner for this shipment.</div>
					</div>

					<!-- Branch Selection -->
					<div class="mb-3">
						<label for="branch_id" class="form-label">
							Branch Destination <span class="required" aria-hidden="true">*</span>
						</label>
						<select id="branch_id" name="branch_id"
							class="form-select <%=branchError != null ? "is-invalid" : ""%>" required>
							<option value="">-- Select Receiving Branch --</option>
							<%
							boolean branchFound = false;
							if (branches != null) {
								for (BranchOption br : branches) {
									boolean selected = br.getBranchId().equals(displayBranchId);
									if (selected) branchFound = true;
							%>
							<option value="<%=esc(br.getBranchId())%>" <%=selected ? "selected" : ""%>>
								<%=esc(br.getName())%>
							</option>
							<%
								}
							}
							if (!branchFound && stockImport.getBranchId() != null) {
								String currentBranchName = stockImport.getBranchName() != null ? stockImport.getBranchName() : stockImport.getBranchId();
							%>
							<option value="<%=esc(stockImport.getBranchId())%>" selected>
								<%=esc(currentBranchName)%> (Current / Inactive)
							</option>
							<%
							}
							%>
						</select>

						<% if (branchError != null) { %>
						<div class="field-error">
							<i class="bi bi-exclamation-circle-fill"></i>
							<span><%=esc(branchError)%></span>
						</div>
						<% } %>
						<div class="form-text">Branch location where goods were delivered.</div>
					</div>

					<!-- Employee (Received By) Selection -->
					<div class="mb-3">
						<label for="employee_id" class="form-label">
							Received By (Staff Member) <span class="required" aria-hidden="true">*</span>
						</label>
						<select id="employee_id" name="employee_id"
							class="form-select <%=employeeError != null ? "is-invalid" : ""%>" required>
							<option value="">-- Select Receiving Staff --</option>
							<%
							boolean employeeFound = false;
							if (employees != null) {
								for (EmployeeOption emp : employees) {
									boolean selected = emp.getEmployeeId().equals(displayEmployeeId);
									if (selected) employeeFound = true;
							%>
							<option value="<%=esc(emp.getEmployeeId())%>" <%=selected ? "selected" : ""%>>
								<%=esc(emp.getName())%>
							</option>
							<%
								}
							}
							if (!employeeFound && stockImport.getEmployeeId() != null) {
								String currentEmpName = stockImport.getEmployeeName() != null ? stockImport.getEmployeeName() : stockImport.getEmployeeId();
							%>
							<option value="<%=esc(stockImport.getEmployeeId())%>" selected>
								<%=esc(currentEmpName)%> (Current / Inactive)
							</option>
							<%
							}
							%>
						</select>

						<% if (employeeError != null) { %>
						<div class="field-error">
							<i class="bi bi-exclamation-circle-fill"></i>
							<span><%=esc(employeeError)%></span>
						</div>
						<% } %>
						<div class="form-text">Staff member who logged receipt.</div>
					</div>

					<!-- Import Date & Time -->
					<div class="mb-3">
						<label for="imported_at" class="form-label">
							Import Timestamp <span class="required" aria-hidden="true">*</span>
						</label>
						<input type="datetime-local" id="imported_at" name="imported_at"
							class="form-control <%=importedAtError != null ? "is-invalid" : ""%>"
							value="<%=esc(displayImportedAt)%>" required>

						<% if (importedAtError != null) { %>
						<div class="field-error">
							<i class="bi bi-exclamation-circle-fill"></i>
							<span><%=esc(importedAtError)%></span>
						</div>
						<% } %>
						<div class="form-text">Delivery verification timestamp.</div>
					</div>

					<!-- Total Cost -->
					<div class="mb-4">
						<label for="total_cost" class="form-label">
							Total Cost (USD) <span class="required" aria-hidden="true">*</span>
						</label>
						<div class="input-group">
							<span class="input-group-text">$</span>
							<input type="number" step="0.01" min="0.01" id="total_cost" name="total_cost"
								class="form-control <%=totalCostError != null ? "is-invalid" : ""%>"
								value="<%=esc(displayTotalCost)%>" placeholder="e.g., 1250.00" required>
						</div>

						<% if (totalCostError != null) { %>
						<div class="field-error">
							<i class="bi bi-exclamation-circle-fill"></i>
							<span><%=esc(totalCostError)%></span>
						</div>
						<% } %>
						<div class="form-text">Net invoice procurement cost for this delivery.</div>
					</div>

					<!-- Form Action Buttons -->
					<div class="d-flex justify-content-between align-items-center gap-2 pt-3 border-top">
						<a href="<%=ctx%>/stockimport" class="btn btn-outline-secondary">
							<i class="bi bi-x-lg"></i>Cancel
						</a>
						<button type="submit" class="btn btn-primary">
							<i class="bi bi-check2"></i>Update Stock Import
						</button>
					</div>
				</form>

			</div>
		</div>
	</main>

	<!-- Footer -->
	<jsp:include page="/includes/footer.jsp" />

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
