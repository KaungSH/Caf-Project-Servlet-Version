<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>${log != null ? 'Edit' : 'Record'} Waste Log - Café Luft</title>
    <link href="${pageContext.request.contextPath}/assets/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Navigation -->
        <jsp:include page="/WEB-INF/views/common/fragments/sidebar_manager.jsp">
            <jsp:param name="activeTab" value="wastelogs"/>
        </jsp:include>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                <h1 class="h2">${log != null ? 'Edit' : 'New'} Waste Record</h1>
                <a href="${pageContext.request.contextPath}/manager/wastelogs" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>

            <div class="card shadow-sm border-0 col-lg-8">
                <div class="card-body p-4">
                    <form action="${pageContext.request.contextPath}/manager/wastelogs" method="post">
                        <input type="hidden" name="action" value="${log != null ? 'update' : 'create'}">
                        <c:if test="${log != null}">
                            <input type="hidden" name="wasteId" value="${log.wasteId}">
                        </c:if>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ingredient Batch</label>
                            <select name="batchId" class="form-select" required>
                                <option value="">-- Select Batch --</option>
                                <c:forEach var="batch" items="${batches}">
                                    <option value="${batch.batchId}" ${log != null && log.batchId == batch.batchId ? 'selected' : ''}>
                                        Batch #${batch.batchId} (${batch.ingredientName})
                                    </option>
                                </c:forEach>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Waste Reason</label>
                            <select name="wasteReasonId" class="form-select" required>
                                <option value="">-- Select Reason --</option>
                                <c:forEach var="r" items="${reasons}">
                                    <option value="${r.wasteReasonId}" ${log != null && log.wasteReasonId == r.wasteReasonId ? 'selected' : ''}>
                                        ${r.reasonName}
                                    </option>
                                </c:forEach>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Quantity Lost</label>
                                <input type="number" step="0.001" name="quantityLost" class="form-control" 
                                       value="${log != null ? log.quantityLost : ''}" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Financial Loss (MMK)</label>
                                <input type="number" step="0.01" name="financialLoss" class="form-control" 
                                       value="${log != null ? log.financialLoss : ''}" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Notes / Explanation</label>
                            <textarea name="notes" class="form-control" rows="3">${log != null ? log.notes : ''}</textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="${pageContext.request.contextPath}/manager/wastelogs" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-save me-1"></i> ${log != null ? 'Update Record' : 'Save Record'}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>
</div>
<script src="${pageContext.request.contextPath}/assets/js/bootstrap.bundle.min.js"></script>
</body>
</html>