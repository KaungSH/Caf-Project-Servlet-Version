	public List<ProductType> findAll(String branch_id) {
		String sql = "SELECT * FROM product_types WHERE isdeleted = false AND branches_branch_id = ? ORDER BY created_at DESC";
		
		List<ProductType> product_types = new ArrayList<>();
		try {
			PreparedStatement ps = con.prepareStatement(sql);
			ps.setString(1, branch_id);
			ResultSet rs = ps.executeQuery();
			
			while(rs.next()) {
				product_types.add(productTypeMapper.mapRow(rs));
			}
			
		}catch(SQLException e) {
			System.out.println("Get All Product Types Failed - " + e);
		}
		
		return product_types;
	}
	
