	public int add(ProductType pt) {
		String sql = "INSERT INTO product_types(type_id, name, description, coverimgpath, price, created_at, category_id, isdeleted, isedited, employee_id, branches_branch_id) VALUES(?, ?, ?, ?, ?, ?, ?, false, false, ?, ?)";
		int rows = 0;
		try {
			PreparedStatement ps = con.prepareStatement(sql);
			
			ps.setString(1, pt.getType_id());
			ps.setString(2, pt.getName());
			ps.setString(3, pt.getDescription());
			ps.setString(4, pt.getCoverimgpath());
			ps.setDouble(5, pt.getPrice());
			ps.setString(6, LocalDateTime.now().toString());
			ps.setString(7, pt.getCategory_id());
			ps.setString(8, pt.getEmployee_id());
			ps.setString(9, pt.getBranch_id());
			
			rows = ps.executeUpdate();
			System.out.println(rows + " row(s) effected in adding Product.");
		}catch(SQLException e) {
			System.out.println("Adding Product Failed - " + e);
		}
		
		for(ProductEntryModel product : pt.getProducts()) {
			product.setEmployee_id(pt.getEmployee_id());
			pservice.add(product, UUID.randomUUID().toString(), pt.getType_id());
			rows++;
		}
		
		return rows;
	}
	
	public int edit(ProductType pt, HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		for(ProductEntryModel product : pt.getProducts()) {
			Boolean i = false;
			for(ProductEntryModel product2 : pservice.findByTypeId(pt.getType_id())) {
				if(product.getSize_id().equals(product2.getSize_id())) {
					System.out.println(product.getSize_id() + "   " + product2.getSize_id());
					pservice.permDelete(product2.getProduct_id(), request, response);
					pservice.add2(product, UUID.randomUUID().toString(), pt.getType_id());
					i = true;
					break;
				}
			}
			if (!i) {
				pservice.add(product, UUID.randomUUID().toString(), pt.getType_id());
			}
		}
		
		String sql = "UPDATE product_types SET name = ?, description = ?, coverimgpath = ?, price = ?, category_id = ?, isedited = true WHERE type_id = ?";
		int rows = 0;
		try {
			PreparedStatement ps = con.prepareStatement(sql);
			
			ps.setString(1, pt.getName());
			ps.setString(2, pt.getDescription());
			ps.setString(3, pt.getCoverimgpath());
			ps.setDouble(4, pt.getPrice());
			ps.setString(5, pt.getCategory_id());
			ps.setString(6, pt.getType_id());
			
			rows = ps.executeUpdate();
			System.out.println(rows + " row(s) effected in adding Product.");
		}catch(SQLException e) {
			System.out.println("Adding Product Failed - " + e);
		}
		return rows;
	}
	
