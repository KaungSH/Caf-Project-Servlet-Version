<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@ page import="cafe.project.servlet.models.Suppliers"%>

<%!public String esc(String value) {
		if (value == null) {
			return "";
		}
		return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
				.replace("'", "&#39;");
	}%>

<%
String nameError = (String) request.getAttribute("nameError");
String contactError = (String) request.getAttribute("contactError");

String nameValue = (String) request.getAttribute("nameValue");
String contactValue = (String) request.getAttribute("contactValue");

if (nameValue == null) {
	nameValue = "";
}

if (contactValue == null) {
	contactValue = "";
}

String ctx = request.getContextPath();
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Add Supplier - Cafe Management System</title>

<!-- Google Fonts & Bootstrap Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
	rel="stylesheet">
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
	rel="stylesheet">

<!-- Centralized Cafe Theme -->
<link rel="stylesheet" href="<%=ctx%>/assets/css/cafe-theme.css">
</head>

<body>

	<main class="page-wrapper">
		<div class="container">

			<!-- Breadcrumb Navigation -->
			<div class="cafe-breadcrumb"
				style="max-width: 740px; margin: 0 auto 16px auto;">
				<a href="<%=ctx%>/home.jsp"><i class="bi bi-house-door me-1"></i>Dashboard</a>
				<span class="separator"><i class="bi bi-chevron-right"></i></span> <a
					href="<%=ctx%>/suppliers">Suppliers</a> <span class="separator"><i
					class="bi bi-chevron-right"></i></span> <span>Add Supplier</span>
			</div>

			<div class="form-container">

				<div class="mb-4 pb-3 border-bottom">
					<h1 class="page-title mb-1">
						<i class="bi bi-person-plus-fill"></i>Register New Supplier
					</h1>
					<p class="page-subtitle">Add a roastery, dairy supplier, or
						packaging vendor to your supply chain.</p>
				</div>

				<form method="post" action="<%=ctx%>/suppliers"
					accept-charset="UTF-8" novalidate>
					<input type="hidden" name="action" value="insert">

					<!-- Supplier Name -->
					<div class="mb-3">
						<label for="name" class="form-label"> Supplier Name <span
							class="required" aria-hidden="true">*</span>
						</label> <input type="text" id="name" name="name"
							class="form-control <%=nameError != null ? "is-invalid" : ""%>"
							value="<%=esc(nameValue)%>" maxlength="100"
							placeholder="e.g., Highland Coffee Roasters, Pure Dairy Co."
							required>

						<%
						if (nameError != null) {
						%>
						<div class="field-error">
							<i class="bi bi-exclamation-circle-fill"></i> <span><%=esc(nameError)%></span>
						</div>
						<%
						}
						%>
						<div class="form-text">Must be a unique vendor name across
							your active cafe catalog.</div>
					</div>

					<!-- Contact Information -->
					<div class="mb-4">
						<label for="contact_info" class="form-label"> Contact
							Information <span class="required" aria-hidden="true">*</span>
						</label> <input type="text" id="contact_info" name="contact_info"
							class="form-control <%=contactError != null ? "is-invalid" : ""%>"
							value="<%=esc(contactValue)%>" maxlength="150"
							placeholder="e.g., Phone: +1 555-0199, Email: orders@highlandroast.com"
							required>

						<%
						if (contactError != null) {
						%>
						<div class="field-error">
							<i class="bi bi-exclamation-circle-fill"></i> <span><%=esc(contactError)%></span>
						</div>
						<%
						}
						%>
						<div class="form-text">Provide direct phone number, email
							address, or representative contact details.</div>
					</div>

					<!-- Form Action Buttons -->
					<div
						class="d-flex justify-content-between align-items-center gap-2 pt-3 border-top">
						<a href="<%=ctx%>/suppliers?action=list"
							class="btn btn-outline-secondary"> <i class="bi bi-x-lg"></i>Cancel
						</a>
						<button type="submit" class="btn btn-primary">
							<i class="bi bi-check2"></i>Save Supplier
						</button>
					</div>
				</form>

			</div>
		</div>
	</main>
	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
